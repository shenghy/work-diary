# ===== 数据库（MySQL）=====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=workdiary
DB_PASSWORD=请填写数据库密码
DB_NAME=workdiary

# ===== 鉴权 =====
# 用 `python -c "import secrets; print(secrets.token_hex(32))"` 生成一个随机值
JWT_SECRET=请填写随机字符串
TOKEN_EXPIRE_DAYS=30

# ===== 邮箱（163 SMTP）=====
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_USER=jspang2026@163.com
SMTP_PASSWORD=请填写邮箱授权码
SMTP_FROM=jspang2026@163.com

# ===== 管理后台 =====
ADMIN_USERNAME=admin
ADMIN_PASSWORD=请设置一个强密码

# ===== 服务 =====
# 监听端口
PORT=8010
# 允许跨域的来源，逗号分隔；桌面/手机客户端无需填写，Web 端按需填写
CORS_ORIGINS=*

# ===== 验证码规则 =====
# 验证码有效期（分钟）
CODE_EXPIRE_MINUTES=10
# 验证码最大错误次数
CODE_MAX_ATTEMPTS=5
# 同邮箱每分钟最多发送条数
CODE_RATE_LIMIT_PER_MINUTE=2
# 限频统计窗口（秒），与每分钟条数配套使用
CODE_RATE_WINDOW_SECONDS=60

# ===== AI 截图识别（通义千问 VL）=====
# 通义千问 API Key，在阿里云百炼平台申请：https://bailian.console.aliyun.com/
# 申请后填入，截图识别功能即可使用；不填则该接口返回 503 提示
DASHSCOPE_API_KEY=

# ===== 附件中转（服务器只暂存，取完即删）=====
# 单个文件大小上限（MB），桌面与手机一致
ATTACHMENT_MAX_MB=100
# 每个任务/备忘最多几个附件
ATTACHMENT_MAX_PER_PARENT=5
# 中转文件最长保留时间（小时）：超时没人下载就删
ATTACHMENT_TTL_HOURS=24
# 分片大小（MB）：微信单次请求有体积限制，2MB 让手机也能传大文件
ATTACHMENT_CHUNK_MB=2
# 中转目录总容量上限（MB），超过拒绝新上传，防止磁盘被塞满影响站点
ATTACHMENT_QUOTA_MB=2048
# 中转目录位置，必须在站点静态目录之外；留空则用 <项目根>/storage/attachments_tmp
ATTACHMENT_TMP_DIR=
